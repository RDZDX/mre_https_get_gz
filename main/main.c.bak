VMINT https_send_request(VMINT sock, https_url_t *url, VMUINT start, VMUINT end)
{
    char request[1024];

    memset(request, 0, sizeof(request));

    sprintf(request,
            "GET %s HTTP/1.1\r\n"
            "Host: %s\r\n"
            "Range: bytes=%u-%u\r\n"
            "Connection: close\r\n"
            "Accept-Encoding: identity\r\n"
            "\r\n",
            url->path,
            url->host,
            start,
            end);

    /*
       Replace with:

       br_sslio_write_all(...)
       br_sslio_flush(...)
    */

    vm_soc_send(sock,
                request,
                strlen(request),
                0);

    return 0;
}

VMINT https_receive_file(VMINT sock, const VMCHAR *name)
{
    VMFILE file;
    VMUINT written;

    char buffer[1024];
    int len;

    VMWCHAR wname[256];

    vm_ascii_to_ucs2(wname,
                     (strlen(name)+1)*2,
                     name);

    file = vm_file_open(
                wname,
                MODE_CREATE_ALWAYS_WRITE,
                TRUE);

    if (file < 0)
        return -1;

    while (1)
    {
        /*
           Replace with:

           len = br_sslio_read(...)
        */

        len = vm_soc_recv(
                  sock,
                  buffer,
                  sizeof(buffer),
                  0);

        if (len <= 0)
            break;

        vm_file_write(
            file,
            buffer,
            len,
            &written);
    }

    vm_file_close(file);

    return 0;
}

VMINT https_download(const VMCHAR *url)
{
    https_url_t info;

    VMINT sock;

    if (https_parse_url(url, &info))
    {
        display_text_line(
            screenbuf,
            "Invalid HTTPS URL",
            0,
            filledDsplByLines,
            nscreen_width,
            nscreen_height,
            2,
            1,
            VM_COLOR_BLACK,
            VM_FALSE);

        return -1;
    }

    display_text_line(
        screenbuf,
        "Connecting HTTPS...",
        0,
        filledDsplByLines,
        nscreen_width,
        nscreen_height,
        2,
        1,
        VM_COLOR_BLACK,
        VM_FALSE);

    sock = https_connect(&info);

    if (sock < 0)
    {
        display_text_line(
            screenbuf,
            "HTTPS connect failed",
            0,
            filledDsplByLines,
            nscreen_width,
            nscreen_height,
            2,
            1,
            VM_COLOR_BLACK,
            VM_FALSE);

        return -1;
    }

    https_send_request(
        sock,
        &info,
        0,
        0xFFFFFFFF);

    https_receive_file(
        sock,
        "e:\\https_download.bin");

    vm_soc_close(sock);

    display_text_line(
        screenbuf,
        "HTTPS download complete",
        0,
        filledDsplByLines,
        nscreen_width,
        nscreen_height,
        2,
        1,
        VM_COLOR_BLACK,
        VM_FALSE);

    return 0;
}

VMINT https_connect(https_url_t *url)
{
    vm_soc_address_t addr;
    VMINT ret;

    if (!url)
        return -1;

    memset(&addr, 0, sizeof(addr));

    /*
     * Create TCP socket
     */
    https_socket = vm_soc_create(
        VM_SOC_SOCK_STREAM,
        VM_SOC_PROTO_TCP);

    if (https_socket < 0)
    {
        display_text_line(
            screenbuf,
            "Socket create failed",
            0,
            filledDsplByLines,
            nscreen_width,
            nscreen_height,
            2,
            1,
            VM_COLOR_BLACK,
            VM_FALSE);

        return -1;
    }

    /*
     * Resolve hostname
     *
     * Replace this with your SDK's
     * DNS resolver function.
     */

    ret = vm_get_host_by_name(
        url->host,
        &addr.addr_len,
        addr.addr);

    if (ret < 0)
    {
        vm_soc_close(https_socket);
        https_socket = -1;

        display_text_line(
            screenbuf,
            "DNS failed",
            0,
            filledDsplByLines,
            nscreen_width,
            nscreen_height,
            2,
            1,
            VM_COLOR_BLACK,
            VM_FALSE);

        return -1;
    }

    addr.port = url->port;

    /*
     * TCP connect
     */

    ret = vm_soc_connect(
        https_socket,
        &addr);

    if (ret < 0)
    {
        vm_soc_close(https_socket);
        https_socket = -1;

        display_text_line(
            screenbuf,
            "TCP connect failed",
            0,
            filledDsplByLines,
            nscreen_width,
            nscreen_height,
            2,
            1,
            VM_COLOR_BLACK,
            VM_FALSE);

        return -1;
    }

    /*
     * BearSSL initialization
     */

    br_ssl_client_init_full(
        &sc,
        &xc,
        TAs,
        TAs_NUM);

    br_ssl_engine_set_buffer(
        &sc.eng,
        ssl_iobuf,
        sizeof(ssl_iobuf),
        1);

    /*
     * Enable hostname verification + SNI
     */

    if (!br_ssl_client_reset(
            &sc,
            url->host,
            0))
    {
        vm_soc_close(https_socket);
        https_socket = -1;

        display_text_line(
            screenbuf,
            "TLS reset failed",
            0,
            filledDsplByLines,
            nscreen_width,
            nscreen_height,
            2,
            1,
            VM_COLOR_BLACK,
            VM_FALSE);

        return -1;
    }

    /*
     * Bind SSL to socket
     */

    br_sslio_init(
        &ioc,
        &sc.eng,
        sock_read,
        NULL,
        sock_write,
        NULL);

    /*
     * Force handshake
     */

    {
        unsigned char dummy = 0;

        ret = br_sslio_write_all(
            &ioc,
            &dummy,
            0);

        if (ret != BR_ERR_OK)
        {
            vm_soc_close(https_socket);
            https_socket = -1;

            display_text_line(
                screenbuf,
                "TLS handshake failed",
                0,
                filledDsplByLines,
                nscreen_width,
                nscreen_height,
                2,
                1,
                VM_COLOR_BLACK,
                VM_FALSE);

            return -1;
        }

        br_sslio_flush(&ioc);
    }

    display_text_line(
        screenbuf,
        "TLS connected",
        0,
        filledDsplByLines,
        nscreen_width,
        nscreen_height,
        2,
        1,
        VM_COLOR_BLACK,
        VM_FALSE);

    return https_socket;
}

static int sock_read(void *ctx,
                     unsigned char *buf,
                     size_t len)
{
    int ret;

    ret = vm_soc_recv(
        https_socket,
        (VMCHAR*)buf,
        len,
        0);

    if (ret <= 0)
        return -1;

    return ret;
}

static int sock_write(void *ctx,
                      const unsigned char *buf,
                      size_t len)
{
    int ret;

    ret = vm_soc_send(
        https_socket,
        (VMCHAR*)buf,
        len,
        0);

    if (ret <= 0)
        return -1;

    return ret;
}

